APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sikertelen megujitas utan ennyi napig marad meg a premium hozzaferes.
BILLING_GRACE_PERIOD_DAYS=7
BILLING_PLAN_NAME="InfoTanár Prémium – havi előfizetés"
BILLING_MONTHLY_PRICE_HUF=2990

# Barion (ADR 0001). test = api.test.barion.com, prod = api.barion.com.
# A POS kulcs titok: csak a szerver .env-jeben legyen.
BARION_ENVIRONMENT=test
BARION_POS_KEY=
# A bolthoz tartozo Barion-fiok e-mail-cime (a penz kedvezmenyezettje).
BARION_PAYEE=
BARION_TIMEOUT=15
# Csak helyi stub szerverhez: felulirja a kornyezet alapjan valasztott URL-t.
BARION_BASE_URL=

# Lecke-videok: privat tarolo es a lejatszasi URL elettartama (perc).
LESSON_VIDEO_DISK=lesson_videos
LESSON_VIDEO_URL_TTL_MINUTES=30
CATALOG_FREE_LESSONS_PER_TRACK=2

# Judge0 kodfuttato. A szerveren a peldany csak localhoston erheto el;
# lokalis fejlesztesnel SSH-tunnel kell:
#   ssh -L 2358:localhost:2358 <user>@<szerver>
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
# Egy Judge0 hivas / kapcsolodas / egy teljes kiertekeles felso korlatja (mp).
# Az utolso kisebb legyen a frontend 60 mp-es timeoutjanal.
JUDGE0_TIMEOUT=20
JUDGE0_CONNECT_TIMEOUT=3
JUDGE0_EVALUATION_DEADLINE=45
# Futtatasok szama percenkent (Futtatas + Beadas): vendegnel IP-nkent, bejelentkezve
# fiokonkent (elofizetonek tobb), napi felso korlattal. A GLOBAL az osszes felhasznalo
# egyuttes kerete: annyi legyen, amennyit a Judge0 peldany elbir.
JUDGE0_RATE_GUEST_PER_MINUTE=10
JUDGE0_RATE_USER_PER_MINUTE=20
JUDGE0_RATE_PREMIUM_PER_MINUTE=40
JUDGE0_RATE_USER_PER_DAY=1000
JUDGE0_RATE_GLOBAL_PER_MINUTE=300

# Statikus kodszabaly-elemzo (#43): Python ertelmezo az API-szerveren (a kodot nem futtatja).
CONSTRAINTS_PYTHON_BINARY=python3
CONSTRAINTS_ANALYZER_TIMEOUT=5

# Szamlazz.hu Szamla Agent (ADR 0002). Az agent-kulcs titok.
SZAMLAZZ_AGENT_KEY=
# AFA-kulcs (pl. 27) vagy adomentessegi kod (pl. AAM) - a konyvelovel egyeztetendo.
SZAMLAZZ_VAT_RATE=27
SZAMLAZZ_INVOICE_PREFIX=
SZAMLAZZ_TIMEOUT=30
# Csak helyi stub szerverhez.
# SZAMLAZZ_BASE_URL=http://127.0.0.1:8098/
