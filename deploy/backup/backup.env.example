# Az infotanar-backup.sh konfiguracioja. A szerveren: /etc/infotanar/backup.env
# (tulajdonos root, jogosultsag 600 - adatbazis-jelszot tartalmaz).

DB_NAME=infotanar
DB_USER=infotanar
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# A Laravel privat taroloja: itt vannak a szamlak (invoices/) es a videok (lesson-videos/).
PRIVATE_STORAGE_DIR=/var/www/infotanar/backend/storage/app/private

# rclone cel "tarolo:utvonal" alakban. Erdemes crypt tarolot hasznalni, hogy a
# mentes mar a szerveren titkositva legyen (lasd docs/runbooks/backup-restore.md).
BACKUP_REMOTE=infotanar-offsite:

# A videok nagyok es az eredetibol ujra eloallithatok: hetente egyszer mennek.
# 1 = hetfo ... 7 = vasarnap.
VIDEO_BACKUP_WEEKDAY=7

# Ide kerul az utolso sikeres mentes idopontja (alapertelmezes: a privat tarolo gyokere).
# STATUS_FILE=/var/www/infotanar/backend/storage/app/private/backup-last-success
