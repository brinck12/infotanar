# Helyi fejlesztesi alapertekek. Az eles szerveren kotelezo elteresek a fajl
# vegen, az "Eles kornyezet" reszben vannak; a deploy a
# `php artisan app:check-config` paranccsal ellenorzi oket.

APP_NAME="InfoTanár"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# A levelekben es a Barion visszairanyitasban hasznalt frontend-cim.
FRONTEND_URL=http://localhost:5173
# Bongeszobol csak ezek az originek hivhatjak az API-t (vesszovel elvalasztva).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# A feluleti szovegek magyarok (lang/hu). Az "en" tartalek marad: hianyzo magyar
# kulcsnal a keretrendszer angol szovege jelenik meg, nem a nyers kulcs.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Napi naplofajl, 14 napig megorizve (LOG_DAILY_DAYS); a "single" egyetlen, vegtelenul novo fajl.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log": a levelek a naploba kerulnek, nem mennek ki.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@infotanar.hu"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sikertelen megujitas utan ennyi napig marad meg a premium hozzaferes.
BILLING_GRACE_PERIOD_DAYS=7
# A szamlan szereplo datumok (kelt, teljesites) idozonaja; a tarolas UTC marad.
BILLING_TIMEZONE=Europe/Budapest
# Ennyi nappal a megujitas elott megy emlekezteto level.
BILLING_RENEWAL_REMINDER_DAYS=3
BILLING_PLAN_NAME="InfoTanár Prémium – havi előfizetés"
BILLING_MONTHLY_PRICE_HUF=2990

# Barion (ADR 0001). test = api.test.barion.com, prod = api.barion.com.
# A POS kulcs titok: csak a szerver .env-jeben legyen.
BARION_ENVIRONMENT=test
BARION_POS_KEY=
# A bolthoz tartozo Barion-fiok e-mail-cime (a penz kedvezmenyezettje).
BARION_PAYEE=
BARION_TIMEOUT=15
# Csak helyi stub szerverhez: felulirja a kornyezet alapjan valasztott URL-t.
BARION_BASE_URL=

# Lecke-videok: privat tarolo es a lejatszasi URL elettartama (perc).
LESSON_VIDEO_DISK=lesson_videos
LESSON_VIDEO_URL_TTL_MINUTES=30
CATALOG_FREE_LESSONS_PER_TRACK=2

# Fajlfeladatok (config/filetasks.php). Privat tarolok: a feladatok csatolt fajljai
# (mentendo) es a diakok beadasai (nem mentjuk); kesobb S3-ra cserelhetok.
EXERCISE_FILES_DISK=exercise_files
SUBMISSION_FILES_DISK=submission_files
# A feladat megoldott, ha a pontszam eleri az ertekelolap ennyi reszet.
FILETASKS_PASS_RATIO=0.8
# Feladatonkent ennyi gyakorlo beadas marad meg; ennyi nap utan mind torlodik.
FILETASKS_KEEP_PER_EXERCISE=10
FILETASKS_RETENTION_DAYS=365
# A diaknak kiadott alairt letoltesi URL elettartama (perc).
FILETASKS_URL_TTL_MINUTES=60
# Egy fajl ertekelesenek idokorlatja (mp) es az egyszerre futo ertekelesek szama.
FILETASKS_EVALUATION_TIMEOUT=25
FILETASKS_MAX_CONCURRENT_EVALUATIONS=4
# Hosszusagok (margo, tabulator) ekkora elteressel egyeznek (mm).
FILETASKS_LENGTH_TOLERANCE_MM=1.0
# Opcionalis viruskereso, pl. "clamdscan --no-summary {path}"; uresen kikapcsolva.
FILETASKS_SCAN_COMMAND=
# Meretkorlatok kategoriankent. Az nginx (client_max_body_size) es a PHP
# (upload_max_filesize, post_max_size) korlatja ezek folott legyen.
FILETASKS_MAX_DOCUMENT_MB=10
FILETASKS_MAX_IMAGE_MB=5
FILETASKS_MAX_TEXT_KB=1024
FILETASKS_MAX_ARCHIVE_MB=50
# Fajlbeadasok szama fiokonkent, es az admin fajlfeltoltesei percenkent.
FILETASKS_RATE_PER_MINUTE=6
FILETASKS_RATE_PER_DAY=150
FILETASKS_ADMIN_UPLOAD_PER_MINUTE=30

# Gyakorlo vizsgak (config/exams.php). A hatarido utan ennyi masodpercig meg
# fogadunk feltoltest; ennyi nap tetlenseg utan zarul le egy gyakorlas.
EXAMS_GRACE_SECONDS=15
EXAMS_IDLE_DAYS=14
# A vizsga forrasfajljainak alairt URL-je eddig el (perc).
EXAMS_FILE_URL_TTL_MINUTES=360
# A lejart probalkozasokat lezaro job ennyit dolgoz fel egy futasban.
EXAMS_CLOSE_BATCH=20
# Vizsga inditasa, feltoltes, beadas: keresek percenkent, fiokonkent.
EXAMS_WRITE_PER_MINUTE=30

# Judge0 kodfuttato. A szerveren a peldany csak localhoston erheto el;
# lokalis fejlesztesnel SSH-tunnel kell:
#   ssh -L 2358:localhost:2358 <user>@<szerver>
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
# Egy Judge0 hivas / kapcsolodas / egy teljes kiertekeles felso korlatja (mp).
# Az utolso kisebb legyen a frontend 60 mp-es timeoutjanal.
JUDGE0_TIMEOUT=20
JUDGE0_CONNECT_TIMEOUT=3
JUDGE0_EVALUATION_DEADLINE=45
# Egyidejuleg futo kiertekelesek felso korlata (0 = nincs); folotte gyors 503 "busy".
# A foglalas elettartama kicsit nagyobb legyen, mint a JUDGE0_EVALUATION_DEADLINE.
JUDGE0_MAX_CONCURRENT=20
JUDGE0_SLOT_TTL=55
JUDGE0_BUSY_RETRY_AFTER=5
# Readiness: a Judge0 varakozo sora ennyi folott figyelmeztet.
JUDGE0_QUEUE_WARN_DEPTH=50
# Alap ido- (mp) es memoriakorlat (KB); egy feladat az admin feluleten feluldefinialhatja.
JUDGE0_CPU_TIME_LIMIT=2
JUDGE0_MEMORY_LIMIT=128000
# Felso hatarok: ne legyenek nagyobbak a Judge0 peldany MAX_CPU_TIME_LIMIT,
# MAX_WALL_TIME_LIMIT es MAX_MEMORY_LIMIT ertekenel (judge0.conf).
JUDGE0_MAX_CPU_TIME_LIMIT=15
JUDGE0_MAX_WALL_TIME_LIMIT=20
JUDGE0_MAX_MEMORY_LIMIT=512000
# Nyelvenkenti idoszorzo: pl. 2 = a C# megoldasok ketszer annyi idot kapnak.
JUDGE0_TIME_FACTOR_CSHARP=1
# Futtatasok szama percenkent (Futtatas + Beadas): vendegnel IP-nkent, bejelentkezve
# fiokonkent (elofizetonek tobb), napi felso korlattal. A GLOBAL az osszes felhasznalo
# egyuttes kerete: annyi legyen, amennyit a Judge0 peldany elbir.
JUDGE0_RATE_GUEST_PER_MINUTE=10
JUDGE0_RATE_USER_PER_MINUTE=20
JUDGE0_RATE_PREMIUM_PER_MINUTE=40
JUDGE0_RATE_USER_PER_DAY=1000
JUDGE0_RATE_GLOBAL_PER_MINUTE=300

# Statikus kodszabaly-elemzo (#43): Python ertelmezo az API-szerveren (a kodot nem futtatja).
CONSTRAINTS_PYTHON_BINARY=python3
CONSTRAINTS_ANALYZER_TIMEOUT=5

# Uzemeltetoi riasztasok cimzettje (ADR 0003): vegleg elbukott job, elutasitott
# szamla, elakadt fizetes. Uresen a riasztas csak a naploba kerul.
ALERT_EMAIL=

# A /api/v1/health/ready reszleteit csak ezzel a tokennel (X-Health-Token fejlec)
# vagy adminkent lehet lekerdezni. Ugyanez az ertek a repo HEALTH_TOKEN secretje.
HEALTH_TOKEN=

# Szamlazz.hu Szamla Agent (ADR 0002). Az agent-kulcs titok.
SZAMLAZZ_AGENT_KEY=
# AFA-kulcs (pl. 27) vagy adomentessegi kod (pl. AAM) - a konyvelovel egyeztetendo.
SZAMLAZZ_VAT_RATE=27
SZAMLAZZ_INVOICE_PREFIX=
SZAMLAZZ_TIMEOUT=30
# Csak helyi stub szerverhez.
# SZAMLAZZ_BASE_URL=http://127.0.0.1:8098/

# Google-belepes (docs/adr/0004-social-login.md, docs/runbooks/go-live.md).
# Kulcsok es GOOGLE_LOGIN_ENABLED=true nelkul a vegpontok 404-et adnak, a gomb nem jelenik meg.
# A redirect URI-t a Google Cloud kliensnel is fel kell venni.
GOOGLE_LOGIN_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://<domain>/api/v1/auth/google/callback
# Csak helyi stub szerverhez (eleshen a Google cimei maradnak):
# GOOGLE_AUTH_URL=
# GOOGLE_TOKEN_URL=
# GOOGLE_USERINFO_URL=

# ---------------------------------------------------------------------------
# Eles kornyezet
# ---------------------------------------------------------------------------
# A szerver .env-jeben a fentiektol igy kell elterni. A csillagozottak nelkul
# a deploy megall; a tobbi hianyara figyelmeztet (szigoru modban az is hiba).
#
#   APP_ENV=production
#   APP_NAME=InfoTanar                      a levelek feladoja es alairasa
# * APP_DEBUG=false
# * APP_KEY=base64:...                      php artisan key:generate --show
#   APP_URL=https://<domain>
#   FRONTEND_URL=https://<domain>
#   LOG_LEVEL=warning
#
#   DB_CONNECTION=mysql
#   DB_HOST=127.0.0.1
#   DB_DATABASE=infotanar
#   DB_USERNAME=infotanar
#   DB_PASSWORD=<jelszo>
#
# Redis: a sor, a cache es a munkamenet ne az adatbazist terhelje (a "database"
# meghajto csak helyi fejlesztesre valo; az app:check-config figyelmeztet ra).
# Telepites es atallas: docs/runbooks/redis.md
#   CACHE_STORE=redis
#   QUEUE_CONNECTION=redis                  a worker: deploy/systemd/infotanar-queue.service
#   SESSION_DRIVER=redis
#   REDIS_CLIENT=phpredis
#   REDIS_HOST=127.0.0.1
#   REDIS_PASSWORD=<jelszo>                 a redis.conf requirepass erteke
#   REDIS_PORT=6379
#
#   MAIL_MAILER=smtp
#   MAIL_HOST=<smtp szerver>
#   MAIL_PORT=587
#   MAIL_USERNAME=<felhasznalo>
#   MAIL_PASSWORD=<jelszo>
#   MAIL_FROM_ADDRESS=noreply@<domain>
#   ALERT_EMAIL=<az uzemelteto cime>
#
#   BARION_ENVIRONMENT=prod
#   BARION_POS_KEY=<titok>
#   BARION_PAYEE=<a Barion-fiok e-mail-cime>
#
#   SZAMLAZZ_AGENT_KEY=<titok>
#   SZAMLAZZ_VAT_RATE=<a konyvelovel egyeztetve>
#
#   JUDGE0_URL=http://localhost:2358
#   JUDGE0_AUTH_TOKEN=<token>
#
#   HEALTH_TOKEN=<hosszu veletlen ertek>      openssl rand -hex 32
#
#   TRUSTED_PROXIES=<proxy IP/CIDR, vesszovel>  CDN/proxy mogott kotelezo, kulonben minden vendeg egy IP; "*" = minden
#   AUDIT_IP_RETENTION_DAYS=90                 ennyi nap utan az audit naplo IP-je nullazodik (audit:prune)
#   AUDIT_DELETE_AFTER_YEARS=                  ures = az audit sorok nem torlodnek; jogaszi dontes

# Regisztracios kapu (LAUNCH-2): open = barki regisztralhat, invite = csak meghivokoddal. ELESBEN (zart beta) invite.
# Az admin felulirhatja az adatbazisban (Meghivokodok oldal); ez csak az alapertek.
REGISTRATION_MODE=open
