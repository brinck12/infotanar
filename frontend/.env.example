# A Laravel backend cime. Lokalis fejlesztesnel: php artisan serve
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Az irasbeli erettsegi napja a visszaszamlalashoz (EEEE-HH-NN). Elesben a hivatalos vizsganaptar szerint.
VITE_EXAM_DATE=2027-05-10

# Barion Pixel (ADR 0001). Uresen a Pixel ki van kapcsolva (fejlesztes, teszt).
# Elesben a Barion-fiok Pixel-azonositoja, pl. BP-0000000000-00.
VITE_BARION_PIXEL_ID=
# true (alapertelmezes): a Pixel csak a latogato hozzajarulasa utan toltodik be.
# false: az alap Pixel a dontes elott is betolt (a Barion leirasa szerinti mukodes).
VITE_BARION_PIXEL_REQUIRES_CONSENT=true
