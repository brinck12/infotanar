# Pelda egy mar telepitett kornyezetre: a Playwright nem indit szervert.
# A valodi cimeket a CI-ban kornyezeti valtozokent add meg (azok nyernek).
# Figyelem: az "api" projekt fixture adatokat (ApiTestSeeder) var, ezert
# stagingen jellemzoen csak a @smoke tesztek futtathatok (npm run test:smoke).
BASE_URL=https://staging.example.com
API_BASE_URL=https://staging.example.com/api/v1/
START_WEB_SERVERS=false
