includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - app
        - bootstrap/app.php
        - config
        - database/seeders
        - database/migrations
        - routes
    # database/factories: a fakerphp/faker hianyzik a require-dev-bol (#60), addig nem elemezheto.
    tmpDir: storage/framework/cache/phpstan
